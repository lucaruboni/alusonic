PROJECT_NAME=torresanbartolo
WORDPRESS_PORT=8080
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=wp_pass_change_me
MYSQL_ROOT_PASSWORD=root_pass_change_me
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WORDPRESS_TABLE_PREFIX=wp_9b7x_
WORDPRESS_AUTH_KEY=change_me_auth_key
WORDPRESS_SECURE_AUTH_KEY=change_me_secure_auth_key
WORDPRESS_LOGGED_IN_KEY=change_me_logged_in_key
WORDPRESS_NONCE_KEY=change_me_nonce_key
WORDPRESS_AUTH_SALT=change_me_auth_salt
WORDPRESS_SECURE_AUTH_SALT=change_me_secure_auth_salt
WORDPRESS_LOGGED_IN_SALT=change_me_logged_in_salt
WORDPRESS_NONCE_SALT=change_me_nonce_salt

# Deploy tema su hosting Aruba (FTP) - usati da scripts/deploy/ftp-deploy.sh
# In CI (GitHub Actions) usa invece i Secrets del repo, non questo file.
ARUBA_FTP_SERVER=ftp.tuodominio.it
ARUBA_FTP_USERNAME=change_me
ARUBA_FTP_PASSWORD=change_me
ARUBA_FTP_REMOTE_DIR=/wp-content/themes/torresan-bnb/
